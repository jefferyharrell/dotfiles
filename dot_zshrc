source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/jefferyharrell/.lmstudio/bin"
# End of LM Studio CLI section

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export PATH="/Pondside/.bin:$PATH"
alias pondside-env="set -a && source <(op inject -i /Pondside/Basement/Env/.env.op) && set +a"

# The next line updates PATH for the Google Cloud SDK.
if [ -f '/Users/jefferyharrell/Downloads/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/jefferyharrell/Downloads/google-cloud-sdk/path.zsh.inc'; fi

# The next line enables shell command completion for gcloud.
if [ -f '/Users/jefferyharrell/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/jefferyharrell/Downloads/google-cloud-sdk/completion.zsh.inc'; fi

# Modern Unix tool aliases — each conditional on the tool being installed.
# Install any of: brew install bat fd fzf zoxide
# Aliases activate automatically once the binary appears on PATH.

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first'
  alias ll='eza -l --group-directories-first --git'
  alias la='eza -la --group-directories-first --git'
  alias lt='eza --tree --level=2 --group-directories-first'
fi

if command -v bat >/dev/null 2>&1; then
  alias cat='bat --paging=never'
fi

# zoxide: gives you `z <partial-name>` to jump to recent dirs.
# Doesn't replace `cd`, just augments. Falls back silently if not installed.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# fzf: Ctrl-R for fuzzy shell history, Ctrl-T for fuzzy file picker.
# Honors brew install location. Loads only if both fzf and the keybinding
# script are present.
if command -v fzf >/dev/null 2>&1 && [ -f "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh" ]; then
  source "$(brew --prefix)/opt/fzf/shell/key-bindings.zsh"
  source "$(brew --prefix)/opt/fzf/shell/completion.zsh"
fi

# SSH directory passthrough: keep LC_REMOTE_PWD in sync with $PWD so any
# outbound ssh (including Ghostty's wrapped ssh function) forwards it via
# the standard SendEnv LC_* rule. Pair with the matching snippet in the
# remote's ~/.zshrc to land in the same directory if it exists there.
typeset -gx LC_REMOTE_PWD="$PWD"
_lc_remote_pwd_sync() { export LC_REMOTE_PWD="$PWD" }
autoload -Uz add-zsh-hook
add-zsh-hook chpwd _lc_remote_pwd_sync

eval "$(starship init zsh)"

# pnpm
export PNPM_HOME="/Users/jefferyharrell/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

export EDITOR="zed --wait"
