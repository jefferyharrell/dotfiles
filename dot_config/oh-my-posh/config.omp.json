{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{.UserName}}@{{.HostName}}:{{.Folder}}",
  "terminal_background": "#232322",
  "accent_color": "p:gold",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "path",
          "style": "diamond",
          "foreground": "p:fg",
          "background": "p:surface",
          "template": " \uea83  {{ .Path }} ",
          "powerline_symbol": "\ue0b4",
          "options": {
            "folder_separator_icon": " \ue0b1 ",
            "home_icon": "~",
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "foreground": "p:fg",
          "foreground_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:fg{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:bg{{ end }}"
          ],
          "background": "p:surface",
          "background_templates": [
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:rust{{ end }}",
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:gold{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:steel{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }} {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b4",
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "foreground": "p:gold",
          "background": "p:surface",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ",
          "powerline_symbol": "\ue0b4",
          "options": {
            "display_mode": "files",
            "fetch_virtual_env": false
          }
        },
        {
          "type": "session",
          "style": "diamond",
          "foreground": "p:fg",
          "background": "p:surface",
          "template": " {{ .UserName }}{{ if .SSHSession }}@{{ .HostName }}{{ end }} ",
          "powerline_symbol": "\ue0b4",
          "trailing_diamond": "\ue0b4"
        }
      ]
    }
  ],
  "palette": {
    "bg": "#1F1F1E",
    "bg-alt": "#2C2C2B",
    "surface": "#3A3837",
    "overlay": "#4D4A4A",
    "fg": "#E8E3DB",
    "fg-dim": "#9E9892",
    "clay": "#C15F3C",
    "clay-lt": "#D97757",
    "gold": "#D9A441",
    "sage": "#8FA46A",
    "steel": "#6E8CA0",
    "rust": "#B24A2E"
  }
}
